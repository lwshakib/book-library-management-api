<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Home</title>
    <link rel="stylesheet" href="/css/app.css" />
  </head>
  <body>
    <%- include('partials/header', { activePage: 'home' }) %>
    <div class="page">
      <header>
        <h1>Explore the Book Library</h1>
        <p>
          Discover new titles, revisit timeless classics, and download digital
          copies from our growing collection curated for curious minds.
        </p>
      </header>

      <div class="layout">
        <div class="main-column">
          <% if (selectedAuthor) { %>
          <div class="filter-indicator" style="margin-bottom: 12px; display: flex; align-items: center; justify-content: space-between; padding: 12px 16px; background: var(--accent-soft); border-radius: 12px; border: 1px solid var(--accent-strong);">
            <span style="font-weight: 500; font-size: 14px; color: var(--accent);">
              Showing books by: <strong><%= selectedAuthor %></strong>
            </span>
            <a href="/" style="font-size: 13px; font-weight: 700; color: var(--accent); text-decoration: none; padding: 4px 10px; border-radius: 8px; background: var(--surface);">Clear filter</a>
          </div>
          <% } %>
          <% if (books && books.length > 0) { %>
          <div class="books-grid">
            <% books.forEach(function (book) { %>
            <article class="book-card">
              <div class="book-cover">
                <% if (book.coverImage) { %>
                <a href="/book/<%= book._id %>">
                  <img
                    src="<%= book.coverImage %>"
                    alt="Cover of <%= book.title %>"
                    loading="lazy"
                  />
                </a>
                <% } else { %>
                <div class="placeholder">Cover coming soon</div>
                <% } %>
              </div>
            <div class="book-content">
              <h3>
                <a
                  href="/book/<%= book._id %>"
                  style="text-decoration: none; color: inherit"
                  ><%= book.title %></a
                >
              </h3>
              <div class="book-meta">
                <span class="muted">By <a href="/?author=<%= encodeURIComponent(book.author) %>" style="color: inherit; text-decoration: none; border-bottom: 1px dotted transparent;" onmouseover="this.style.borderBottomColor='var(--muted)'" onmouseout="this.style.borderBottomColor='transparent'"><%= book.author %></a></span>
              </div>
                <div class="book-links" style="margin-top: 12px;">
                  <% if (book.buyHardCopyFrom) { %>
                  <a
                    href="<%= book.buyHardCopyFrom %>"
                    target="_blank"
                    rel="noopener"
                  >
                    Buy
                  </a>
                  <% } else { %>
                  <a href="/book/<%= book._id %>">
                    View Details
                  </a>
                  <% } %>
                </div>
              </div>
            </article>
            <% }); %>
          </div>
          <% if (pagination && pagination.totalPages > 1) { %>
          <div class="pagination">
            <% const authorQS = pagination.author ? '&author=' + encodeURIComponent(pagination.author) : ''; const currentPage = pagination.page; const totalPages =
            pagination.totalPages; const prevDisabled = !pagination.hasPrevPage
            ? "disabled" : ""; const nextDisabled = !pagination.hasNextPage ?
            "disabled" : ""; const windowSize = 5; const half =
            Math.floor(windowSize / 2); let start = Math.max(1, currentPage -
            half); let end = Math.min(totalPages, start + windowSize - 1); if
            (end - start + 1 < windowSize) { start = Math.max(1, end -
            windowSize + 1); } %>
            <a
              class="<%= prevDisabled %>"
              href="/?page=<%= (pagination.prevPage || 1) + authorQS %>"
              >Prev</a
            >
            <% if (start > 1) { %>
            <a href="/?page=1<%= authorQS %>">1</a>
            <% if (start > 2) { %><span>…</span><% } %> <% } %> <% for (let p =
            start; p <= end; p++) { %> <% if (p === currentPage) { %>
            <span class="active"><%= p %></span>
            <% } else { %>
            <a href="/?page=<%= p + authorQS %>"><%= p %></a>
            <% } %> <% } %> <% if (end < totalPages) { %> <% if (end <
            totalPages - 1) { %><span>…</span><% } %>
            <a href="/?page=<%= totalPages + authorQS %>"><%= totalPages %></a>
            <% } %>
            <a
              class="<%= nextDisabled %>"
              href="/?page=<%= (pagination.nextPage || totalPages) + authorQS %>"
              >Next</a
            >
          </div>
          <% } %> <% } else { %>
          <div class="empty-state">
            <% if (selectedAuthor) { %>
              No books found by <%= selectedAuthor %>. Try resetting your filter.
            <% } else { %>
              No books available yet. Check back soon or ask an administrator to seed the library.
            <% } %>
          </div>
          <% } %>
        </div>
        <aside class="sidebar">
          <div class="sidebar-card">
            <h3>Popular Authors</h3>
            <% if (popularAuthors && popularAuthors.length > 0) { %>
            <div class="author-list">
              <% popularAuthors.slice(0, 6).forEach(function (author) { %>
              <a href="/?author=<%= encodeURIComponent(author.name) %>" class="author-item" style="text-decoration: none; display: flex; align-items: center; justify-content: space-between;">
                <span class="author-name"><%= author.name %></span>
                <span class="author-count"><%= author.bookCount %> books</span>
              </a>
              <% }); %>
            </div>
            <% } else { %>
            <p class="muted">
              No author data yet. Add more books to build trends.
            </p>
            <% } %>
          </div>
        </aside>
      </div>
    </div>
    <script src="/js/theme.js" defer></script>
  </body>
</html>
